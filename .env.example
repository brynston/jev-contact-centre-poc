# Required for Jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional conventional LLM comparator: direct or openrouter (default: direct).
LLM_PROVIDER_MODE=direct

# Direct OpenAI-compatible chat/completions API. Existing LLM_* settings still work.
# OPENAI_API_KEY can be used instead of LLM_API_KEY; LLM_API_KEY takes precedence.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
# Optional comma-separated models in the UI dropdown. The default model is always included.
LLM_MODELS=

# OpenRouter uses its own key, base URL and provider-prefixed model ID.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_MODELS=openai/gpt-5-mini,cloudflare/clef,cloudflare/clef-flash
# Clef and Clef Flash automatically use the Decisions API.
# Optional additional Decisions model IDs (other models default to Chat Completions).
OPENROUTER_DECISION_MODELS=
# Optional full endpoint override; otherwise derived from OPENROUTER_BASE_URL.
# The default is https://openrouter.ai/api/alpha/decisions.
OPENROUTER_DECISIONS_URL=

# Optional rough cost inputs for comparator metrics, USD per 1M tokens.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
OPENROUTER_INPUT_COST_PER_MILLION=0
OPENROUTER_OUTPUT_COST_PER_MILLION=0

PORT=8787
# Current public Jev input price at time this POC was created; override if pricing changes.
TYPESAFE_INPUT_COST_PER_MILLION=0.042
