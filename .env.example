# Required for Jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional conventional LLM comparator (OpenAI-compatible chat/completions API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# Optional rough cost inputs for comparator metrics, USD per 1M tokens.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

PORT=8787
# Current public Jev input price at time this POC was created; override if pricing changes.
TYPESAFE_INPUT_COST_PER_MILLION=0.042
